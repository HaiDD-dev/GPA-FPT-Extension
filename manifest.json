{
  "manifest_version": 3,
  "name": "GPA FPT",
  "version": "1.0.0",
  "description": "Tính GPA từ trang Báo cáo điểm FAP (FPT University), tự chọn môn được tính và nhập điểm dự kiến.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GPA FPT",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://fap.fpt.edu.vn/Report/Transcript*",
        "https://fap.fpt.edu.vn/report/transcript*"
      ],
      "js": ["src/lib/gpa.js", "src/lib/store.js", "src/content/transcript.js"],
      "css": ["src/content/transcript.css"],
      "run_at": "document_idle"
    }
  ]
}
